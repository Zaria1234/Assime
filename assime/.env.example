# Copier ce fichier en .env.local (il n'est jamais envoyé sur GitHub).

# --- IA : Google Gemini ---
# Clé gratuite : https://aistudio.google.com/apikey
# Sans préfixe VITE_ : la clé reste sur le serveur et n'arrive jamais dans le navigateur.
GEMINI_API_KEY=
# Facultatif : modèle à utiliser (par défaut l'alias gemini-flash-latest, qui suit le dernier Flash).
# GEMINI_MODEL=gemini-flash-latest

# --- Back-end : Supabase (voir docs/BACKEND.md) ---
# Sans ces deux lignes, l'app garde tout sur le téléphone.
# Clé PUBLIQUE uniquement (anon / publishable). Jamais la clé service_role / secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
